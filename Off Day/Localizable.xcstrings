    "intent.error.overReach" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The day you are querying is no longer within the validity period of the Public Holiday Template. Please update the template or update the Off Day App"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照会した日付は祝日テンプレートの有効期間外です。テンプレートまたはOff Dayアプリを更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조회한 날짜는 더 이상 공휴일 템플릿의 유효 기간에 포함되지 않습니다. 템플릿을 업데이트하거나 Off Day 앱을 업데이트하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你查询的这一天，已经不在公共假期模板的有效期内，请更新模板或者更新休息日App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你查詢的這一日，已經不在公共假期模板的有效期內，請更新模板或者更新休息日App。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你查詢的這一日，已經不在公共假期模板的有效期內，請更新模板或者更新休息日App。"
          }
        }
      }
    },
