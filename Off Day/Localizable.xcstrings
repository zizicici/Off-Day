    "Get Day Detail of ${date}" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get Day Detail of ${date}"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${date}の詳細を取得"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${date}의 날짜 상세 정보 가져오기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取 ${date} 的详情"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獲取 ${date} 的詳情"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獲取 ${date} 的詳情"
          }
        }
      }
    },
    "If the result is true, it is a Clash Day. Clash Day means that the public holiday template, base calendar, and user annotations (optional) for this day have different criteria for determining whether it is an Off Day." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the result is true, it is a Clash Day. Clash Day means that the public holiday template, base calendar, and user annotations (optional) for this day have different criteria for determining whether it is an Off Day."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果がtrueの場合は衝突日です。衝突日とは、この日の祝日テンプレート・ベースカレンダー・ユーザー注釈（任意）で休日かどうかの判断が異なることを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과가 true이면 충돌일입니다. 충돌일은 해당 날짜가 휴일인지 판단하는 기준이 공휴일 템플릿, 기본 캘린더, 사용자 주석(선택 사항) 사이에서 서로 다른 경우를 의미합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果结果为 true 则是冲突日。冲突日意味着这一天的用户标注信息（可选）、公共假期模板以及基础日历对于“这一天是否是休息日”的判断是不同的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果結果為 true 則是衝突日。衝突日意味着這一日的用戶標註信息（可選）、公共假期模板以及基礎日曆對於“這一日是否是休息日”的判斷是不同的。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果結果為 true 則是衝突日。衝突日意味着這一日的用戶標註信息（可選）、公共假期模板以及基礎日曆對於“這一日是否是休息日”的判斷是不同的。"
          }
        }
      }
    },
    "If the result is true, it is an off day, otherwise, it is a work day." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the result is true, it is an off day, otherwise, it is a work day."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果がtrueの場合は休日、そうでない場合は出勤日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과가 true이면 휴일이고, 그렇지 않으면 근무일입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果结果为 true 则是休息日，反之则是工作日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果結果為 true 則是休息日，反之則是工作日。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果結果為 true 則是休息日，反之則是工作日。"
          }
        }
      }
    },
    "Including user annotaions" : {
