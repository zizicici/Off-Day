    "batchEditor.alert.message.normal%@,%@,%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All user annotations from %1$@ to\n%2$@ will be %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@から\n%2$@までのユーザー注釈をすべて%3$@に変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@부터\n%2$@까지의 모든 사용자 주석이 %3$@(으)로 변경됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从%1$@到%2$@的用户标注将全部更新为%3$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從%1$@到%2$@的用戶標註將全部更新為%3$@"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從%1$@到%2$@的用戶標註將全部更新為%3$@"
          }
        }
      }
    },
    "batchEditor.alert.message.toBlank%@,%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All user annotations from %1$@ to\n%2$@ will be erased."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@から\n%2$@までのユーザー注釈をすべて消去します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@부터\n%2$@까지의 모든 사용자 주석이 지워집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从%1$@到%2$@的用户标注将全部删除，变为空白"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
