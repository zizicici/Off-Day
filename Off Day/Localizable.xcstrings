    "backup.section.toggle.hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The database file will be automatically backed up to the 'Off Day' folder in iCloud. Up to once per day."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースファイルはiCloudの「Off Day」フォルダに自動的にバックアップされます。1日1回まで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터베이스 파일은 iCloud의 'Off Day' 폴더에 자동으로 백업됩니다. 하루 최대 한 번 실행됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库文件将会自动同步到iCloud里的'Off Day'文件夹。每天最多备份一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "數據庫文件將會自動同步到iCloud裡的'Off Day'文件夾。每天最多備份一次。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "數據庫文件將會自動同步到iCloud裡的'Off Day'文件夾。每天最多備份一次。"
          }
        }
      }
    },
