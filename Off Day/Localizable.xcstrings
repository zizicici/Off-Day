    "intent.comment.update.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update User Text Comment by Date with specific Content. If Content is absent, will delete existing User Text Comment by Date."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付でユーザーテキストメモを指定の内容に更新します。内容がない場合は既存のメモを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜별 사용자 텍스트 메모를 지정한 내용으로 업데이트합니다. 내용이 없으면 해당 날짜의 기존 사용자 텍스트 메모를 삭제합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据日期更新文本备注为备注内容，如果备注内容为空，且对应日期已有文本备注，则会删除已有的文本备注。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據日期更新文本備註為備註內容，如果備註內容為空，且對應日期已有文本備註，則會刪除已有的文本備註。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據日期更新文本備註為備註內容，如果備註內容為空，且對應日期已有文本備註，則會刪除已有的文本備註。"
          }
        }
      }
    },
