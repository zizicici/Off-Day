    "widget.today.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See whether today is a day off or a workday."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日が休日か出勤日かを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘이 휴무일인지 근무일인지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼查看今天休息还是上班。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼查看今天休息還是上班。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼查看今天休息還是上班。"
          }
        }
      }
    },
