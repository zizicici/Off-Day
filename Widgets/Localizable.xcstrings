    "widget.lockScreen.threeDays.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See today and the next two days as calendar dates, with weekdays and holiday details."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日・明日・明後日を、曜日や祝日情報付きのカレンダー形式で表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘, 내일, 모레의 날짜와 요일, 공휴일 정보를 달력 형식으로 표시합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以日历日期形式查看今天、明天和后天的星期与节日信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以日曆日期形式查看今天、明天和後天的星期與節日資訊。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以日曆日期形式查看今天、明天和後天的星期與節日資訊。"
          }
        }
      }
    },
