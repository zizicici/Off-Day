    "widget.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See whether today and tomorrow are days off, with holiday names."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日と明日が休日かどうかと祝日名を表示します。"
          }
