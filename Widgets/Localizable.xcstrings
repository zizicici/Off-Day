    "widget.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See whether today and tomorrow are days off, with holiday names."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日と明日が休日かどうかと祝日名を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘과 내일의 휴무 여부와 공휴일 이름을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看今天和明天的休息、工作状态及节假日名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看今天和明天的休息、工作狀態及節假日名稱。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "查看今天和明天的休息、工作狀態及節假日名稱。"
          }
        }
      }
