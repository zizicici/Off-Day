        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘과 내일의 휴무 여부와 공휴일 이름을 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看今天和明天的休息、工作状态及节假日名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
