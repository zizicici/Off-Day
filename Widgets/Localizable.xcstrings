          "stringUnit": {
            "state": "translated",
            "value": "Today & Tomorrow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日と明日"
          }
        },
        "ko": {
          "stringUnit": {
